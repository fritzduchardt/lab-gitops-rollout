#! /usr/bin/env bash

# MINOR: Added error handling for non-existent directories
concat_yamls () {
	local file
	if [[ ! -d "$1" ]]; then
		echo "Error: Directory $1 does not exist" >&2
		return 1
	fi
	for file in "$1"/*; do
		if ! [[ -d "$file" ]]; then
			echo "---"
			cat "$file"
		fi
	done

	if [[ -d "$1/static" ]]; then
		for file in "$1"/static/*; do
			if ! [[ -d "$file" ]]; then
				echo "---"
				sops -d "$file"
			fi
		done
	fi
}

# MINOR: Added error message for kapp command failure
apply() {
	echo "Applying Kubernetes manifests"
	local -a kapp_cmd=(kapp --yes deploy --default-label-scoping-rules=false --apply-default-update-strategy=fallback-on-replace --dangerous-override-ownership-of-existing-resources -a "$MYKS_APP" -f -)
	concat_yamls "$MYKS_RENDERED_APP_DIR" | "${kapp_cmd[@]}" || {
		echo "kapp command failed" >&2
		return 1
	}
}

main() {
	if ! apply; then
		echo "Failed to apply manifests" >&2
		exit 1
	fi
}

main
